[project]
requires = ["nodejs-24"]

[dev]
build = ["pnpm", "install"]
run = ["sh", "-c", "DEPLOY_RUN_PORT=${DEPLOY_RUN_PORT:-5000} pnpm run dev"]

[deploy]
build = "pnpm install && pnpm approve-builds esbuild vue-demi && pnpm run build"
run = "COZE_PROJECT_ENV=PROD NODE_ENV=production DEPLOY_RUN_PORT=$DEPLOY_RUN_PORT node server/index.js"
