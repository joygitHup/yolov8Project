{
  "name": "yolov8-video-analysis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,RUNTIME,CLIENT\" -c \"blue,cyan,green\" \"pnpm:server\" \"pnpm:runtime\" \"pnpm:client\"",
    "dev:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-all.ps1",
    "dev:stack": "concurrently -k -n \"YOLO,SERVER,RUNTIME,CLIENT\" -c \"magenta,blue,cyan,green\" \"pnpm:yolo\" \"pnpm:server\" \"pnpm:runtime\" \"pnpm:client\"",
    "yolo": "python yolo-service/run.py",
    "build": "pnpm run build:client",
    "preview": "vite preview",
    "client": "vite",
    "server": "python backend/run.py",
    "runtime": "python -u backend/manage.py run_runtime",
    "build:client": "vue-tsc -b && vite build",
    "mtx:docker": "docker compose up -d mediamtx",
    "mq:docker": "docker compose up -d rabbitmq kafka",
    "jobs": "python backend/manage.py run_jobs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.0",
    "element-plus": "^2.8.0",
    "express": "^4.19.2",
    "hls.js": "^1.7.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.1.0"
  }
}
